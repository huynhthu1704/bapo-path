{
  "name": "bapo-path",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:demo": "VITE_LOCAL_MODE=1 vite",
    "check:prompts": "node scripts/check-prompts.mjs",
    "test": "node --test tests/compass/*.test.mjs && node compass/test-first.mjs",
    "test:first": "node compass/test-first.mjs origin/main --bug",
    "check:spec": "node compass/check-spec.mjs",
    "test:rules": "node --test tests/rules.test.mjs",
    "test:rules:emulator": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-bapo \"npm run test:rules\"",
    "test:e2e": "playwright test",
    "verify": "npm run check:prompts && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10"
  }
}
