{
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run dev:demo)",
      "Bash(npm run check:prompts)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e -- *)",
      "Bash(npm run verify)",
      "Bash(npx playwright test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push *:main*)",
      "Bash(npx firebase-tools* deploy*)",
      "Read(./**/*service-account*.json)"
    ]
  }
}
