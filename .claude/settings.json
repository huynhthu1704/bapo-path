{
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run dev:demo)",
      "Bash(npm run check:prompts)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e -- *)",
      "Bash(npm run verify)",
      "Bash(npx playwright test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm test)",
      "Bash(node compass/check-spec.mjs)",
      "Bash(node compass/build-views.mjs)",
      "Bash(node compass/check-guardrails.mjs *)",
      "Bash(node compass/plan-file.mjs *)",
      "Bash(node compass/test-first.mjs *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push *:main*)",
      "Bash(npx firebase-tools* deploy*)",
      "Read(./**/*service-account*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/compass/hooks/guard-edit.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
